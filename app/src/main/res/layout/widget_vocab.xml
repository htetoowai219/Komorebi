<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Flip Button (Top Left) -->
    <ImageView
        android:id="@+id/btn_widget_flip"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:padding="6dp"
        android:src="@drawable/ic_flip"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Flip Card"
        android:clickable="true"
        android:focusable="true" />

    <!-- Refresh Button (Top Right) -->
    <ImageView
        android:id="@+id/btn_widget_refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:padding="6dp"
        android:src="@drawable/ic_refresh"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Next Word"
        android:clickable="true"
        android:focusable="true" />

    <!-- Word Type Badge (Bottom Left) -->
    <TextView
        android:id="@+id/txt_widget_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:text="VOCAB"
        android:textColor="#8A94A6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- Chapter/Category Name (Bottom Right) -->
    <TextView
        android:id="@+id/txt_widget_chapter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:text="Chapter 1"
        android:textColor="#6A7280"
        android:textSize="10sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Central Front Layout -->
    <LinearLayout
        android:id="@+id/layout_widget_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/txt_widget_type"
        android:layout_below="@id/btn_widget_refresh"
        android:layout_toStartOf="@id/btn_widget_refresh"
        android:layout_toEndOf="@id/btn_widget_flip"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Japanese word (Kanji/Kana) -->
        <TextView
            android:id="@+id/txt_widget_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日本語"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Pronunciation Reading (furigana/kana) -->
        <TextView
            android:id="@+id/txt_widget_reading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="にほんご"
            android:textColor="#60A5FA"
            android:textSize="14sp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- English translation/Meaning -->
        <TextView
            android:id="@+id/txt_widget_meaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Japanese language"
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="2" />

    </LinearLayout>

    <!-- Central Back/Detailed Layout -->
    <LinearLayout
        android:id="@+id/layout_widget_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/txt_widget_type"
        android:layout_below="@id/btn_widget_refresh"
        android:layout_toStartOf="@id/btn_widget_refresh"
        android:layout_toEndOf="@id/btn_widget_flip"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Word Context Header -->
        <TextView
            android:id="@+id/txt_widget_back_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="日本語 [にほんご]"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Notes -->
        <TextView
            android:id="@+id/txt_widget_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Notes: study language."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Example Sentence -->
        <TextView
            android:id="@+id/txt_widget_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Example sentence."
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="italic"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</RelativeLayout>
